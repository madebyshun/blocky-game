# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Settings → Environment Variables.

# Token on Base (already the default in api/colony.js)
TOKEN_ADDRESS=0xE72A0C42b584a3E7A4503a82D1337dEB52adE885

# Pick ONE fee source:
# FEES_USD_OVERRIDE=37.5          # quick test: fixed number
# FEES_URL=https://...            # JSON endpoint returning {"feesUsd": 123.45}
# FEE_WALLET=0xYourFeeWallet      # dedicated wallet that receives creator fees

# Strongly recommended with FEE_WALLET: the public RPC (mainnet.base.org) rate limits quickly.
# Free key: alchemy.com -> Create app -> Base Mainnet -> copy the HTTPS URL.
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional
# CACHE_MS=20000                  # read the chain at most once per 20s
# FEES_OFFSET_USD=0               # negative = subtract what the wallet held before launch
# FEE_TOKENS=0x...,0x...          # extra ERC20s in the fee wallet to count
# FEE_PER_CITIZEN=5
# LAUNCH_TIME_MS=1791200000000
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
