# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Settings → Environment Variables.

# How new Blockies are earned
COUNT_MODE=buys                 # buys (default): every $USD_PER_BLOCKY a wallet buys (added up) = 1 Blocky. fees: creator fees.
# USD_PER_BLOCKY=10             # overrides usdPerBlocky in src/config.js (changing it only affects later buys)
# MAX_SUPPLY=10000              # no more Blockies after this many (supply in src/config.js)
# WHALE_USD=1000                # a single buy this big also builds a Whale Fountain (whaleUsd in src/config.js)
# CITIZEN_DAYS=14               # a Blocky is a newcomer this long, then a citizen: an NFT (citizenDays in src/config.js; lower only)
# MIN_BUY_USD=1                 # ignore buys smaller than this
# BACKFILL_HOURS=24             # testing: also count buys from the last N hours (max ~24h of trades)
# POOL_ID=0x61ccc84e302c1a95fb66435a285e95581134bfc2a11d4fbb88ed07e68ca2e4c0   # BLOCKY/NVDAc pool
# TOKEN_ADDRESS=0xE72A0C42b584a3E7A4503a82D1337dEB52adE885
# STOCK_TOKENS=0x...,0x...      # more tokenized stocks on Base for the Stock Exchange ticker (NVDAc comes from the pool)
# LAUNCH_TIME_MS=               # when the city starts; default = first time the API runs
# HOLD_CHECK_MINUTES=15         # how often holders' $BLOCKY balances are checked (sellers' Blockies leave)
# RESOLVE_WALLETS=1             # read each trade's receipt for the real wallet (smart wallets) and the rarity seed
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY   # recommended in production

# Storage (required in production; without it state lives in memory)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_KEY=basecity-v1            # a new name = a fresh city at 0 / 10,000

# NFT claims (BaseCity Blockies, deployed from /deploy.html)
# NFT_CONTRACT=0x...
# CLAIM_SIGNER_KEY=0x...        # signs claims; server only, never commit it
# SITE_URL=https://your-domain  # NFT metadata links and share images

# Only for COUNT_MODE=fees
# FEE_WALLET=0x...
# EXCLUDE_TOKENS=0xE72A0C42b584a3E7A4503a82D1337dEB52adE885
# FEES_USD_OVERRIDE=37.5
