{
  "functions": {
    "api/recap.js": {
      "includeFiles": "api/_fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/r/:day",
      "destination": "/api/recap?day=:day"
    },
    {
      "source": "/live",
      "destination": "/index.html"
    },
    {
      "source": "/b",
      "destination": "/blocky.html"
    },
    {
      "source": "/b/:n",
      "destination": "/blocky.html"
    },
    {
      "source": "/api/os/:path*",
      "destination": "/api/opensea?p=:path*"
    }
  ]
}
